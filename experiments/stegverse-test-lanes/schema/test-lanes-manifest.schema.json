{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/test-lanes-manifest.v1.json",
  "title": "StegVerse Test Lanes Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "test_id",
    "primary_provider",
    "task",
    "lanes",
    "credential_policy"
  ],
  "properties": {
    "schema_version": {"const": "stegverse.test-lanes-manifest.v1"},
    "test_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "description": {"type": "string"},
    "primary_provider": {"const": "stegverse_local"},
    "task": {
      "type": "object",
      "required": ["task_id", "source", "source_blob_sha", "prompt_profile"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "source_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "prompt_profile": {"type": "string", "minLength": 1},
        "expected_output_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "credential_policy": {
      "type": "object",
      "required": ["authority", "manifest_contains_credentials", "credential_export_allowed"],
      "properties": {
        "authority": {"const": "TV/TVC"},
        "manifest_contains_credentials": {"const": false},
        "credential_export_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lane_id", "provider", "provider_role", "capsule_id", "capability", "mode"],
        "properties": {
          "lane_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
          "provider": {"type": "string", "minLength": 1},
          "provider_role": {"enum": ["PRIMARY", "CONTROL_OR_FALLBACK_ONLY"]},
          "capsule_id": {"type": "string", "minLength": 3},
          "capability": {"type": "string", "minLength": 1},
          "mode": {"enum": ["REFERENCE", "RAW", "GOVERNED"]},
          "model": {"type": ["string", "null"]},
          "required": {"type": "boolean", "default": false},
          "parameters": {"type": "object"},
          "governance_profile": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "comparison": {
      "type": "object",
      "properties": {
        "group_by": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
