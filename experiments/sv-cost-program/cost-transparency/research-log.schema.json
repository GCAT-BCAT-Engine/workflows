{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stegverse.actual-cost-disclosure-research-log.v1",
  "title": "Actual Cost Disclosure Research Log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider",
    "task_id",
    "started_at",
    "steps",
    "protocol_complete"
  ],
  "properties": {
    "schema": {
      "const": "stegverse.actual-cost-disclosure-research-log/v1"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "const": "SV-RECON-001"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol_complete": {
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "surface",
          "action",
          "finding",
          "minutes"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "surface": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "finding": {
            "type": "string"
          },
          "material_cost_components_found": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minutes": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
