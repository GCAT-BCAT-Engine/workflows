{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/credentialless-ui-cost-observation.v1.json",
  "title": "Credentialless provider UI cost observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider",
    "model",
    "task_id",
    "candidate_ref",
    "observation_mode",
    "isolated_single_candidate_window",
    "before",
    "after",
    "provider_api_key_transferred_to_stegverse",
    "non_tv_tvc_secret_or_token_used",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "stegverse.credentialless-ui-cost-observation/v1"
    },
    "provider": {
      "enum": [
        "openai",
        "anthropic",
        "deepseek",
        "zai"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "const": "SV-RECON-001"
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "observation_mode": {
      "enum": [
        "DIRECT_REQUEST_COST_USD",
        "USAGE_CREDIT_SPENT_USD",
        "QUOTA_PERCENT",
        "EXACT_TOKENS"
      ]
    },
    "isolated_single_candidate_window": {
      "const": true
    },
    "before": {
      "type": "object"
    },
    "after": {
      "type": "object"
    },
    "subscription_monthly_equivalent_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "rate_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_observation": {
      "type": [
        "object",
        "null"
      ]
    },
    "provider_api_key_transferred_to_stegverse": {
      "const": false
    },
    "non_tv_tvc_secret_or_token_used": {
      "const": false
    },
    "claim_boundary": {
      "const": "CREDENTIALLESS_PROVIDER_UI_REQUEST_BOUND_OBSERVATION_ONLY"
    }
  }
}
