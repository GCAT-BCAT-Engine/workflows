{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/math-solver-compute-request.schema.json",
  "title": "Math Solver Research Compute Request",
  "type": "object",
  "required": ["request_id", "research_id", "protocol_hash", "dataset_refs", "analysis_objectives", "methods", "required_outputs", "budget_authorization_ref", "execution_authority"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "research_id": {"type": "string", "minLength": 1},
    "protocol_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "analysis_objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method_id", "family", "purpose", "assumptions"],
        "properties": {
          "method_id": {"type": "string", "minLength": 1},
          "family": {"enum": ["descriptive", "regression", "event_study", "change_point", "survival", "bayesian", "simulation", "optimization", "formal_proof", "other"]},
          "purpose": {"type": "string", "minLength": 1},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "seed": {"type": ["integer", "null"]},
          "software_ref": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["point_estimates", "standard_errors", "confidence_intervals", "effect_sizes", "diagnostics", "sensitivity_tests", "negative_controls", "power_analysis", "missing_data_analysis", "reproducibility_receipt"]}
    },
    "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "default": 0.05},
    "budget_authorization_ref": {"type": "string", "minLength": 1},
    "maximum_compute_cost_usd": {"type": "number", "minimum": 0},
    "execution_authority": {"const": true},
    "requested_at": {"type": "string", "format": "date-time"},
    "request_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
