{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/research-payment-authorization.schema.json",
  "title": "Governed Research Payment Authorization",
  "type": "object",
  "required": [
    "authorization_id",
    "research_id",
    "protocol_hash",
    "budget_hash",
    "stage_id",
    "currency",
    "authorized_amount_minor",
    "payment_provider",
    "payment_evidence_ref",
    "payment_verified",
    "creates_execution_authority",
    "status"
  ],
  "properties": {
    "authorization_id": {"type": "string", "minLength": 1},
    "research_id": {"type": "string", "minLength": 1},
    "protocol_hash": {"type": "string", "minLength": 32},
    "budget_hash": {"type": "string", "minLength": 32},
    "stage_id": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[a-z]{3}$"},
    "authorized_amount_minor": {"type": "integer", "minimum": 1},
    "payment_provider": {"enum": ["stripe", "other_verified_provider"]},
    "payment_evidence_ref": {"type": "string", "minLength": 1},
    "provider_event_id": {"type": ["string", "null"]},
    "provider_object_id": {"type": ["string", "null"]},
    "payment_verified": {"const": true},
    "payment_status": {"enum": ["paid", "succeeded"]},
    "payment_purpose": {"const": "governed_research_stage"},
    "evidence_only": {"const": true},
    "creates_execution_authority": {"const": false},
    "governance_decision_ref": {"type": ["string", "null"]},
    "execution_gate_ref": {"type": ["string", "null"]},
    "refundable_balance_minor": {"type": "integer", "minimum": 0},
    "status": {"enum": ["payment_verified_pending_governance", "authorized_for_named_stage", "consumed", "partially_consumed", "released", "refunded", "failed_closed"]},
    "created_utc": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
