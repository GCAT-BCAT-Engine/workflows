{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/research-result.schema.json",
  "title": "Governed Research Result",
  "type": "object",
  "required": ["result_id", "research_id", "request_hash", "estimates", "diagnostics", "sensitivity_tests", "negative_controls", "conclusion_class", "validation_status", "actual_cost"],
  "properties": {
    "result_id": {"type": "string", "minLength": 1},
    "research_id": {"type": "string", "minLength": 1},
    "request_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "estimates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "estimate", "standard_error", "interval_level", "interval_lower", "interval_upper", "effect_size", "units"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "estimate": {"type": "number"},
          "standard_error": {"type": ["number", "null"], "minimum": 0},
          "interval_level": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1},
          "interval_lower": {"type": ["number", "null"]},
          "interval_upper": {"type": ["number", "null"]},
          "effect_size": {"type": ["number", "null"]},
          "p_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "units": {"type": "string"},
          "practical_significance_note": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/test_result"}},
    "sensitivity_tests": {"type": "array", "items": {"$ref": "#/$defs/test_result"}},
    "negative_controls": {"type": "array", "items": {"$ref": "#/$defs/test_result"}},
    "missing_data_analysis": {"type": "array", "items": {"$ref": "#/$defs/test_result"}},
    "conclusion_class": {"enum": ["unsupported", "inconclusive", "exploratory_support", "moderate_support", "strong_support", "contradicted", "not_identifiable"]},
    "conclusion_text": {"type": "string"},
    "causal_claim_authorized": {"type": "boolean"},
    "validation_status": {"enum": ["pending", "passed", "failed", "disputed"]},
    "independent_validation_ref": {"type": ["string", "null"]},
    "actual_cost": {
      "type": "object",
      "required": ["currency", "authorized", "spent", "released"],
      "properties": {
        "currency": {"const": "USD"},
        "authorized": {"type": "number", "minimum": 0},
        "spent": {"type": "number", "minimum": 0},
        "released": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "result_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "test_result": {
      "type": "object",
      "required": ["test_id", "status", "summary"],
      "properties": {
        "test_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "warning", "not_run"]},
        "statistic": {"type": ["number", "null"]},
        "threshold": {"type": ["number", "null"]},
        "summary": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
